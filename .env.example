NODE_ENV=development
PORT=3000
SERVICE_NAME=workshop-service
SERVICE_VERSION=0.1.0
LOG_LEVEL=info
LOG_FORMAT=json
JWT_SECRET=change-me-with-a-secret-from-your-secret-manager
JWT_ISSUER=fiap-tech-challenge-auth-function
JWT_AUDIENCE=fiap-tech-challenge-api
JWT_REQUIRED_CUSTOMER_STATUS=ACTIVE
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=workshop_service
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root-password
DB_DATABASE=workshop_service
DB_SSL=false
MESSAGING_ENABLED=false
RABBITMQ_URL=amqp://replace-with-broker-credentials@localhost:5672
RABBITMQ_MAX_RETRIES=3
CONSUMED_MESSAGE_LEASE_MS=300000
METRICS_ENABLED=true
